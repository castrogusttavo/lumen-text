{
  "name": "lumen-text-web",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "scripts": {
    "dev": "astro dev",
    "build": "node scripts/check-facts.mjs && node scripts/check-bench.mjs && node scripts/fetch-release.mjs && astro build",
    "preview": "astro preview",
    "check": "astro check",
    "images": "node scripts/make-images.mjs",
    "extract": "node scripts/extract-docs-data.mjs && node scripts/extract-themes.mjs",
    "build:preview": "ALLOW_PENDING_BENCH=1 pnpm run build",
    "check:bench": "node scripts/check-bench.mjs",
    "check:facts": "node scripts/check-facts.mjs",
    "check:overflow": "BASE_PATH=/ ALLOW_PENDING_BENCH=1 node scripts/fetch-release.mjs && BASE_PATH=/ astro build --outDir dist-check && node scripts/check-overflow.mjs"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "playwright-core": "^1.65.0",
    "sharp": "^0.35.5",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "^7.3.6",
    "@astrojs/react": "^7.1.4",
    "@astrojs/sitemap": "^3.7.4",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@fontsource/instrument-serif": "^5.3.0",
    "@hugeicons/core-free-icons": "^4.4.0",
    "@tailwindcss/vite": "^4.3.5",
    "astro": "^7.4.7",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwindcss": "^4.3.5"
  },
  "packageManager": "pnpm@12.4.1"
}