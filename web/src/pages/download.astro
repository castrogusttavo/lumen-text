---
import Base from "../layouts/Base.astro";
import Icon from "../components/Icon.astro";
import release from "../data/release.json";
import releases from "../data/releases.json";
import { renderNotes } from "../lib/md";
import { GITHUB, REPO, url } from "../lib/url";

type Asset = { name: string; url: string; size: number; sha256?: string | null } | undefined;
const A = release.assets as Record<string, Asset>;
const v = release.version ?? "<version>";
const mb = (n?: number) => (n ? `${(n / 1048576).toFixed(1)} MB` : "");
const date = release.publishedAt ? new Date(release.publishedAt).toLocaleDateString("en-US", { year: "numeric", month: "long", day: "numeric", timeZone: "UTC" }) : "";

const packages = [
  { key: "deb", icon: "package", title: "Debian, Ubuntu, Mint, Pop!_OS", ext: ".deb", cmd: (f: string) => `sudo apt install ./${f}`, fallback: `lumen-text_${v}-1_amd64.deb` },
  { key: "rpm", icon: "package", title: "Fedora, RHEL, Rocky, Alma, openSUSE", ext: ".rpm", cmd: (f: string) => `sudo dnf install ./${f}`, fallback: `lumen-text-${v}-1.x86_64.rpm` },
  { key: "arch", icon: "package", title: "Arch, Manjaro, EndeavourOS", ext: ".pkg.tar.zst", cmd: (f: string) => `sudo pacman -U ${f}`, fallback: `lumen-text-bin-${v}-1-x86_64.pkg.tar.zst` },
  { key: "appimage", icon: "box", title: "Any distribution", ext: "AppImage", cmd: (f: string) => `chmod +x ${f} && ./${f}`, fallback: `lumen-text-${v}-x86_64.AppImage` },
  { key: "tarball", icon: "archive", title: "Portable", ext: ".tar.gz", cmd: (f: string) => `tar xzf ${f}`, fallback: `lumen-text-${v}-linux-x86_64.tar.gz` },
] as const;
const tar = A.tarball?.name ?? `lumen-text-${v}-linux-x86_64.tar.gz`;
const dir = tar.replace(/\.tar\.gz$/, "");
const appimage = A.appimage?.name ?? `lumen-text-${v}-x86_64.AppImage`;
const pubkey = "RWQoQesrU+NXnwocGP2j42WnwJuiGX/qTELkdL0ykq6TA+ASp5mmzyYU";
const installUser = `curl -fLO ${A.tarball?.url ?? `${GITHUB}/releases/latest/download/${tar}`} && tar xzf ${tar} && ./${dir}/bin/lumen-text --install-user`;
const dl = (a: Asset, fb: string) => a?.url ?? `${GITHUB}/releases/latest`;
const tabs = [
  { id: "macos", label: "macOS", icon: "apple" },
  { id: "windows", label: "Windows", icon: "windows" },
  { id: "linux", label: "Linux", icon: "terminal" },
] as const;
const facts = [
  { icon: "cpu", t: "No GPU needed", d: "Everything is drawn on the CPU, on Wayland or X11." },
  { icon: "shield", t: "Signed and verifiable", d: "SHA-256 sums for every file, minisign signatures for the updater." },
  { icon: "layers", t: "Updates itself", d: "Where it can do so safely; distribution packages are never touched." },
  { icon: "github", t: "Free and open source", d: "MIT licensed. No account, no telemetry." },
] as const;
const kind = (n: string) => (n.endsWith(".deb") ? ".deb" : n.endsWith(".rpm") ? ".rpm" : n.endsWith(".zst") ? "Arch" : n.endsWith("AppImage") ? "AppImage" : n.endsWith(".zip") ? "Windows" : n.endsWith(".dmg") ? (n.includes("aarch64") ? "macOS arm64" : "macOS Intel") : ".tar.gz");
---
<Base title="Download" description="Download Lumen for macOS, Windows and Linux (.deb, .rpm, Arch, AppImage, tar.gz) with checksums and minisign signatures." path="/download">
  <div id="dl" data-repo={REPO} data-version={release.version ?? ""}>
    <section class="dl-hero relative isolate overflow-hidden">
      <div class="dl-glow" aria-hidden="true"></div>
      <div class="container-x relative pb-10 pt-16 text-center md:pb-14 md:pt-24">
        <span class="inline-flex items-center gap-2 rounded-full border border-line2 bg-card px-4 py-1.5 text-[13px] text-muted">
          <span class="size-1.5 rounded-full bg-accent"></span> Stable release
        </span>
        <h1 class="dl-ver mt-6" id="dl-version" aria-label={`Version ${v}`}>{release.version ?? "latest"}</h1>
        <p class="mt-4 flex flex-wrap items-center justify-center gap-x-3 gap-y-1 text-[15px] text-muted">
          {date && <span class="inline-flex items-center gap-1.5"><Icon name="calendar" size={16} class="text-faint" />{date}</span>}
          {date && <span class="text-faint" aria-hidden="true">·</span>}
          <a class="dl-link inline-flex items-center gap-1" href={url("/changelog")}>View changelog <Icon name="arrow" size={16} /></a>
          <span class="text-faint" aria-hidden="true">·</span>
          <a class="dl-link inline-flex items-center gap-1" href={url("/roadmap")}>Roadmap <Icon name="arrow" size={16} /></a>
        </p>
        <p class="lead mx-auto mt-5 max-w-xl text-balance">A lean code editor with no web view. Free, MIT licensed, no account.</p>

        <p id="os-note" hidden class="mx-auto mt-6 max-w-xl rounded-2xl border border-line bg-card px-5 py-3 text-sm text-muted"></p>

        <div class="mt-10 inline-flex" role="tablist" aria-label="Platform" id="dl-tabs" hidden>
          <div class="dl-seg">
            {tabs.map((t) => (
              <button type="button" role="tab" id={`tab-${t.id}`} aria-controls={`panel-${t.id}`} aria-selected="false" data-tab={t.id} tabindex="-1">
                <Icon name={t.icon} size={18} /> {t.label}
              </button>
            ))}
          </div>
        </div>
      </div>
    </section>

    <section class="container-x pb-6">
      <div class="mx-auto max-w-4xl space-y-6">
        <!-- macOS -->
        <article class="dl-stage plus" role="tabpanel" id="panel-macos" aria-labelledby="tab-macos" data-dlpanel="macos" data-os-card="macos">
          <div class="plus-b"></div>
          <div class="dl-os"><span class="dl-tile"><Icon name="apple" size={34} /></span>
            <div><h2>macOS</h2><p>macOS 11 or newer · Apple Silicon and Intel</p></div>
            <span class="dl-badge">Beta</span>
          </div>
          <div class="mt-8 grid gap-3 sm:grid-cols-2">
            <a class="dl-cta dl-cta-main" href={dl(A.macosArm, "")} rel="noopener" data-download="macos">
              <Icon name="download" size={22} /><span><strong>Apple Silicon</strong><small>{A.macosArm?.name ?? `lumen-text-${v}-macos-aarch64.dmg`} {A.macosArm ? `· ${mb(A.macosArm.size)}` : ""}</small></span>
            </a>
            <a class="dl-cta" href={dl(A.macosIntel, "")} rel="noopener">
              <Icon name="download" size={22} /><span><strong>Intel</strong><small>{A.macosIntel?.name ?? `lumen-text-${v}-macos-x86_64.dmg`} {A.macosIntel ? `· ${mb(A.macosIntel.size)}` : ""}</small></span>
            </a>
          </div>
          <p class="dl-note"><Icon name="info" size={16} class="shrink-0" /> Open the .dmg and drag Lumen Text to Applications. It is ad-hoc signed, not notarized: right-click, <em>Open</em> the first time.</p>
        </article>

        <!-- Windows -->
        <article class="dl-stage plus" role="tabpanel" id="panel-windows" aria-labelledby="tab-windows" data-dlpanel="windows" data-os-card="windows">
          <div class="plus-b"></div>
          <div class="dl-os"><span class="dl-tile"><Icon name="windows" size={34} /></span>
            <div><h2>Windows</h2><p>Windows 10 or newer · x86_64 · portable zip</p></div>
            <span class="dl-badge">Beta</span>
          </div>
          <div class="mt-8">
            <a class="dl-cta dl-cta-main sm:max-w-md" href={dl(A.windows, "")} rel="noopener" data-download="windows">
              <Icon name="download" size={22} /><span><strong>Download .zip</strong><small>{A.windows?.name ?? `lumen-text-${v}-windows-x86_64.zip`} {A.windows ? `· ${mb(A.windows.size)}` : ""}</small></span>
            </a>
          </div>
          <p class="dl-note"><Icon name="info" size={16} class="shrink-0" /> Unzip and run <code>lumen-text.exe</code>. It is not code-signed, so SmartScreen may warn: <em>More info</em>, then <em>Run anyway</em>.</p>
        </article>

        <!-- Linux -->
        <article class="dl-stage plus" role="tabpanel" id="panel-linux" aria-labelledby="tab-linux" data-dlpanel="linux" data-os-card="linux">
          <div class="plus-b"></div>
          <div class="dl-os"><span class="dl-tile"><Icon name="terminal" size={34} /></span>
            <div><h2>Linux</h2><p>x86_64 · Wayland and X11 · glibc 2.35 or newer</p></div>
            <span class="dl-badge dl-badge-ok">Stable</span>
          </div>

          <div class="mt-8">
            <p class="eyebrow">Recommended · installs in your home folder, updates itself, no root</p>
            <div class="dl-cmd mt-3">
              <code tabindex="0" data-install>{installUser}</code>
              <button type="button" class="dl-copy" data-copy aria-label="Copy the install command"><span data-i-copy><Icon name="copy" size={18} /></span><span data-i-ok hidden><Icon name="check" size={18} /></span></button>
            </div>
            <p class="mt-3 text-xs text-faint">Already running Lumen? <code class="font-mono">lumen-text --install-user</code> does the same from the running binary.</p>
          </div>

          <p class="eyebrow mt-10">Or pick a package</p>
          <ul class="mt-3 grid gap-3 md:grid-cols-2">
            {packages.map((r) => {
              const a = A[r.key];
              const file = a?.name ?? r.fallback;
              return (
                <li class="dl-pkg" data-asset={r.key}>
                  <div class="flex items-start gap-3">
                    <span class="dl-tile dl-tile-sm"><Icon name={r.icon} size={20} /></span>
                    <div class="min-w-0">
                      <h3>{r.title}</h3>
                      <p class="break-all font-mono text-[11.5px] text-faint"><span data-file>{file}</span> <span data-size>{a ? `· ${mb(a.size)}` : ""}</span></p>
                    </div>
                  </div>
                  <div class="dl-cmd dl-cmd-sm"><code tabindex="0" data-cmd={r.key}>{r.cmd(file)}</code><button type="button" class="dl-copy" data-copy aria-label={`Copy the ${r.ext} install command`}><span data-i-copy><Icon name="copy" size={16} /></span><span data-i-ok hidden><Icon name="check" size={16} /></span></button></div>
                  <a class="dl-cta dl-cta-sm" data-href href={dl(a, "")} rel="noopener"><Icon name="download" size={18} /> Download {r.ext}</a>
                  {a?.sha256 && <p class="break-all font-mono text-[10.5px] text-faint">sha256 <span data-sha>{a.sha256}</span></p>}
                </li>
              );
            })}
          </ul>
        </article>
      </div>
    </section>

    <section class="container-x py-14">
      <ul class="mx-auto grid max-w-4xl gap-4 sm:grid-cols-2 lg:grid-cols-4">
        {facts.map((f) => (
          <li class="rounded-card border border-line bg-card p-5">
            <span class="dl-tile dl-tile-sm"><Icon name={f.icon} size={20} /></span>
            <h3 class="mt-3 text-[15px] font-medium">{f.t}</h3>
            <p class="mt-1 text-sm leading-relaxed text-muted">{f.d}</p>
          </li>
        ))}
      </ul>
    </section>

    <section class="container-x pb-24">
      <div class="mx-auto max-w-4xl space-y-4">
        <article class="min-w-0 rounded-card border border-line bg-card p-6 md:p-8" id="verify">
          <div class="flex items-center gap-3"><span class="dl-tile dl-tile-sm"><Icon name="verified" size={20} /></span><div><p class="eyebrow">Verify</p><h2 class="text-xl font-medium tracking-tight">Checksums and minisign</h2></div></div>
          <p class="mt-3 text-sm text-muted">Every release publishes <code class="font-mono">SHA256SUMS</code>. The AppImage, the tarball, the Windows zip and the macOS disk images are also signed with <a class="dl-link underline decoration-line2 underline-offset-4" href="https://jedisct1.github.io/minisign/" rel="noopener">minisign</a>; the public key below is the one embedded in the editor, which refuses any update that does not verify against it.</p>
          <div class="dl-cmd mt-4"><pre tabindex="0" data-verify><code>{`# in the folder where you downloaded the files
sha256sum -c SHA256SUMS --ignore-missing
minisign -Vm ${appimage} -P ${pubkey}`}</code></pre><button type="button" class="dl-copy" data-copy aria-label="Copy the verify commands"><span data-i-copy><Icon name="copy" size={18} /></span><span data-i-ok hidden><Icon name="check" size={18} /></span></button></div>
          <dl class="mt-4 grid gap-x-6 gap-y-1 font-mono text-xs sm:grid-cols-[auto_1fr]"><dt class="text-faint">Public key</dt><dd class="break-all">{pubkey}</dd><dt class="text-faint">Key id</dt><dd>9F57E3532BEB4128</dd></dl>
        </article>

        <div class="grid gap-4 md:grid-cols-2">
          <article class="min-w-0 rounded-card border border-line bg-card p-6">
            <div class="flex items-center gap-3"><span class="dl-tile dl-tile-sm"><Icon name="sparkles" size={20} /></span><div><p class="eyebrow">TypeScript</p><h2 class="text-lg font-medium tracking-tight">Install the language server once</h2></div></div>
            <p class="mt-3 text-sm text-muted">A project that already has <code class="font-mono">@typescript/native-preview</code> is used first.</p>
            <div class="dl-cmd mt-3"><code tabindex="0">npm i --prefix ~/.local/share/lumen-text/tsgo @typescript/native-preview</code><button type="button" class="dl-copy" data-copy aria-label="Copy the command"><span data-i-copy><Icon name="copy" size={18} /></span><span data-i-ok hidden><Icon name="check" size={18} /></span></button></div>
          </article>
          <article class="min-w-0 rounded-card border border-line bg-card p-6">
            <div class="flex items-center gap-3"><span class="dl-tile dl-tile-sm"><Icon name="info" size={20} /></span><div><p class="eyebrow">Requirements</p><h2 class="text-lg font-medium tracking-tight">What you need</h2></div></div>
            <ul class="mt-3 space-y-1.5 text-sm text-muted">
              <li><strong class="font-medium text-fg">C library:</strong> glibc 2.35 or newer (built on Ubuntu 22.04)</li>
              <li><strong class="font-medium text-fg">Libraries:</strong> libxkbcommon, Wayland and X11 are loaded at run time</li>
              <li><strong class="font-medium text-fg">Clipboard on Wayland:</strong> <code class="font-mono text-[0.9em]">wl-clipboard</code></li>
              <li><strong class="font-medium text-fg">TypeScript:</strong> Node.js, only to install the optional <code class="font-mono text-[0.9em]">tsgo</code></li>
            </ul>
          </article>
        </div>

        <details class="dl-fold group rounded-card border border-line bg-card" id="notes">
          <summary><span><span class="eyebrow">Release notes</span> <span class="ml-2 font-mono text-sm text-fg">{release.tag ?? "Latest"}</span></span><Icon name="arrow" size={18} class="dl-chev" /></summary>
          <div class="border-t border-line p-6">
            <div class="notes text-sm text-muted" set:html={renderNotes(release.notes) || "<p>No notes for this release.</p>"} />
            <a class="dl-link mt-3 inline-flex items-center gap-1 text-sm underline decoration-line2 underline-offset-4" href={url("/changelog")}>Full changelog <Icon name="arrow" size={16} /></a>
          </div>
        </details>

        <details class="dl-fold group rounded-card border border-line bg-card" id="previous">
          <summary><span><span class="eyebrow">Previous versions</span></span><Icon name="arrow" size={18} class="dl-chev" /></summary>
          <ul class="divide-y divide-line border-t border-line px-6">
            {releases.slice(0, 12).map((r) => (
              <li class="flex flex-wrap items-center gap-x-5 gap-y-2 py-3 text-sm">
                <a class="font-mono font-medium hover:underline" href={r.url} rel="noopener">{r.tag}</a>
                <time class="text-faint" datetime={r.publishedAt}>{new Date(r.publishedAt).toLocaleDateString("en-US", { year: "numeric", month: "short", day: "numeric", timeZone: "UTC" })}</time>
                <span class="ml-auto flex flex-wrap gap-3">
                  {r.assets.map((a) => <a class="text-muted underline decoration-line2 underline-offset-4 hover:text-fg" href={a.url} rel="noopener">{kind(a.name)}</a>)}
                </span>
              </li>
            ))}
          </ul>
          <p class="px-6 pb-5 pt-3 text-xs text-faint">Older versions are on <a class="underline" href={`${GITHUB}/releases`} rel="noopener">GitHub Releases</a>.</p>
        </details>

        <p class="pt-6 text-center text-sm text-faint">By downloading Lumen you agree to the <a class="dl-link underline decoration-line2 underline-offset-4" href={`${GITHUB}/blob/main/LICENSE`} rel="noopener">MIT license</a>. Build from source or browse every version: <a class="dl-link underline decoration-line2 underline-offset-4" href={`${GITHUB}/releases`} rel="noopener">all releases</a> · <a class="dl-link underline decoration-line2 underline-offset-4" href={`${GITHUB}#install`} rel="noopener">install docs</a></p>
      </div>
    </section>
  </div>
</Base>

<style>
  .dl-hero { background: radial-gradient(60% 50% at 50% 0%, color-mix(in srgb, var(--accent) 10%, transparent), transparent 70%); }
  .dl-glow { position: absolute; inset: -20% 10% auto; height: 420px; z-index: -1; background: radial-gradient(closest-side, color-mix(in srgb, var(--accent) 16%, transparent), transparent); filter: blur(40px); opacity: .7; pointer-events: none; }
  .dl-ver { font-size: clamp(2.6rem, 10.5vw, 7.5rem); line-height: 1; font-weight: 600; letter-spacing: -0.045em; font-family: var(--font-mono); background: linear-gradient(180deg, var(--fg) 30%, color-mix(in srgb, var(--fg) 45%, transparent)); -webkit-background-clip: text; background-clip: text; color: transparent; overflow-wrap: anywhere; }
  .dl-link { color: var(--fg); text-decoration-color: var(--line-strong); transition: color .15s; }
  .dl-link:hover { color: var(--accent); }

  .dl-seg { display: inline-flex; gap: 4px; padding: 5px; border-radius: 999px; border: 1px solid var(--line-strong); background: var(--card); backdrop-filter: blur(10px); }
  .dl-seg button { display: inline-flex; align-items: center; gap: .5rem; height: 42px; padding: 0 1.15rem; border-radius: 999px; font-size: .95rem; font-weight: 500; color: var(--muted); transition: color .15s, background .15s; }
  .dl-seg button:hover { color: var(--fg); }
  .dl-seg button[aria-selected="true"] { background: var(--fg); color: var(--bg); }

  .dl-stage { border: 1px solid var(--line-strong); border-radius: 28px; padding: clamp(1.4rem, 4vw, 2.75rem); background: linear-gradient(180deg, color-mix(in srgb, var(--fg) 5%, transparent), var(--card)); box-shadow: 0 30px 80px -40px rgba(0,0,0,.6); }
  .dl-stage[hidden] { display: none; }
  .dl-os { display: flex; align-items: center; gap: 1rem; }
  .dl-os h2 { font-size: 1.6rem; font-weight: 600; letter-spacing: -0.02em; }
  .dl-os p { font-size: .9rem; color: var(--muted); }
  .dl-tile { display: grid; place-items: center; width: 60px; height: 60px; flex: none; border-radius: 18px; border: 1px solid var(--line-strong); background: var(--card-solid); color: var(--fg); }
  .dl-tile-sm { width: 40px; height: 40px; border-radius: 12px; }
  .dl-badge { margin-left: auto; border-radius: 999px; border: 1px solid var(--line-strong); padding: .25rem .75rem; font-size: .75rem; color: var(--muted); }
  .dl-badge-ok { background: var(--accent); color: var(--accent-ink); border-color: transparent; font-weight: 600; }

  .dl-cta { display: flex; align-items: center; gap: .9rem; min-width: 0; padding: 1rem 1.25rem; border-radius: 18px; border: 1px solid var(--line-strong); background: var(--card-solid); color: var(--fg); transition: transform .18s, border-color .18s, background .18s; }
  .dl-cta:hover { transform: translateY(-2px); border-color: var(--faint); }
  .dl-cta span { display: flex; flex-direction: column; min-width: 0; }
  .dl-cta strong { font-weight: 600; font-size: 1.02rem; }
  .dl-cta small { font-family: var(--font-mono); font-size: .7rem; color: var(--faint); overflow-wrap: anywhere; }
  .dl-cta-main { background: var(--fg); color: var(--bg); border-color: transparent; }
  .dl-cta-main:hover { background: color-mix(in srgb, var(--fg) 90%, var(--accent)); border-color: transparent; }
  .dl-cta-main small { color: color-mix(in srgb, var(--bg) 62%, transparent); }
  .dl-cta-sm { padding: .6rem 1rem; border-radius: 12px; font-size: .9rem; font-weight: 500; }
  .dl-note { display: flex; gap: .6rem; margin-top: 1.5rem; font-size: .85rem; line-height: 1.55; color: var(--muted); }
  .dl-note :global(svg) { margin-top: 2px; color: var(--faint); }
  .dl-note code { font-family: var(--font-mono); font-size: .9em; color: var(--fg); }

  .dl-cmd { position: relative; min-width: 0; border-radius: 14px; border: 1px solid var(--line); background: var(--bg-2); }
  .dl-cmd code, .dl-cmd pre { display: block; overflow-x: auto; white-space: pre-wrap; overflow-wrap: anywhere; padding: .9rem 3.4rem .9rem 1rem; font-family: var(--font-mono); font-size: 12.5px; line-height: 1.6; color: var(--fg); }
  .dl-cmd-sm code { padding: .6rem 3rem .6rem .8rem; font-size: 12px; }
  .dl-copy { position: absolute; top: 6px; right: 6px; display: grid; place-items: center; width: 36px; height: 36px; border-radius: 10px; border: 1px solid var(--line); background: var(--bg); color: var(--muted); transition: color .15s, border-color .15s; }
  .dl-cmd-sm .dl-copy { width: 30px; height: 30px; top: 4px; right: 4px; }
  .dl-copy:hover { color: var(--fg); border-color: var(--line-strong); }
  .dl-copy[data-done="true"] { color: var(--accent); border-color: var(--accent); }

  .dl-pkg { display: flex; flex-direction: column; gap: .8rem; min-width: 0; padding: 1.1rem; border-radius: 18px; border: 1px solid var(--line); background: var(--card-solid); }
  .dl-pkg h3 { font-size: .95rem; font-weight: 600; }
  @media (min-width: 768px) { .dl-pkg:last-child:nth-child(odd) { grid-column: 1 / -1; } }

  .dl-fold > summary { display: flex; align-items: center; justify-content: space-between; gap: 1rem; padding: 1.1rem 1.5rem; cursor: pointer; list-style: none; }
  .dl-fold > summary::-webkit-details-marker { display: none; }
  .dl-fold :global(.dl-chev) { transition: transform .2s; color: var(--faint); transform: rotate(90deg); }
  .dl-fold[open] :global(.dl-chev) { transform: rotate(-90deg); }

  @media (max-width: 480px) { .dl-seg button { padding: 0 .8rem; font-size: .88rem; } .dl-tile { width: 52px; height: 52px; } }
</style>

<script>
  // Static HTML is the fallback; refresh from the GitHub API so a new release shows up without a rebuild.
  const root = document.getElementById("dl");
  const repo = root?.dataset.repo;
  const patterns: Record<string, RegExp> = { deb: /_amd64\.deb$/, rpm: /\.x86_64\.rpm$/, arch: /\.pkg\.tar\.zst$/, appimage: /x86_64\.AppImage$/, tarball: /linux-x86_64\.tar\.gz$/ };
  const cmds: Record<string, (f: string) => string> = {
    deb: (f) => `sudo apt install ./${f}`, rpm: (f) => `sudo dnf install ./${f}`, arch: (f) => `sudo pacman -U ${f}`,
    appimage: (f) => `chmod +x ${f} && ./${f}`, tarball: (f) => `tar xzf ${f}`,
  };
  if (root && repo) {
    fetch(`https://api.github.com/repos/${repo}/releases/latest`, { headers: { accept: "application/vnd.github+json" } })
      .then((r) => (r.ok ? r.json() : Promise.reject()))
      .then((rel) => {
        if (!rel?.tag_name || rel.tag_name.replace(/^v/, "") === root.dataset.version) return;
        const el = document.getElementById("dl-version");
        if (el) el.textContent = rel.tag_name.replace(/^v/, "");
        for (const [key, re] of Object.entries(patterns)) {
          const a = rel.assets?.find((x: { name: string }) => re.test(x.name));
          const li = root.querySelector<HTMLElement>(`[data-asset="${key}"]`);
          if (!a || !li) continue;
          li.querySelector<HTMLAnchorElement>("[data-href]")!.href = a.browser_download_url;
          li.querySelector("[data-file]")!.textContent = a.name;
          li.querySelector("[data-size]")!.textContent = `· ${(a.size / 1048576).toFixed(1)} MB`;
          li.querySelector(`[data-cmd="${key}"]`)!.textContent = cmds[key]!(a.name);
        }
      })
      .catch(() => {});
  }

  // Platform tabs. Without JS every panel is shown one under the other and the tab strip stays hidden.
  const ua = navigator.userAgent;
  const os = /Windows/i.test(ua) ? "windows" : /Mac/i.test(ua) && !/iPhone|iPad/i.test(ua) ? "macos" : /Android|iPhone|iPad/i.test(ua) ? "mobile" : "linux";
  const tabsEl = document.getElementById("dl-tabs");
  const tabs = [...document.querySelectorAll<HTMLButtonElement>("[data-tab]")];
  const panels = [...document.querySelectorAll<HTMLElement>("[data-dlpanel]")];
  const select = (id: string, focus = false) => {
    tabs.forEach((t) => { const on = t.dataset.tab === id; t.setAttribute("aria-selected", String(on)); t.tabIndex = on ? 0 : -1; if (on && focus) t.focus(); });
    panels.forEach((p) => (p.hidden = p.dataset.dlpanel !== id));
  };
  if (tabsEl && tabs.length) {
    tabsEl.hidden = false;
    select(os === "mobile" ? "linux" : os);
    tabs.forEach((t, i) => {
      t.addEventListener("click", () => select(t.dataset.tab!));
      t.addEventListener("keydown", (e) => {
        const d = e.key === "ArrowRight" ? 1 : e.key === "ArrowLeft" ? -1 : 0;
        if (d) { e.preventDefault(); select(tabs[(i + d + tabs.length) % tabs.length]!.dataset.tab!, true); }
      });
    });
  }
  const note = document.getElementById("os-note");
  if (note && os === "mobile") { note.hidden = false; note.textContent = "Open this page on your desktop to download Lumen."; }

  document.querySelectorAll<HTMLButtonElement>("[data-copy]").forEach((b) =>
    b.addEventListener("click", async () => {
      const text = b.parentElement?.querySelector("code")?.textContent ?? "";
      const ok = b.querySelector<HTMLElement>("[data-i-ok]"), cp = b.querySelector<HTMLElement>("[data-i-copy]");
      try {
        await navigator.clipboard.writeText(text);
        b.dataset.done = "true"; if (ok && cp) { ok.hidden = false; cp.hidden = true; }
        b.setAttribute("aria-label", "Copied");
      } catch { b.setAttribute("aria-label", "Select the text and copy it"); }
      setTimeout(() => { b.dataset.done = "false"; if (ok && cp) { ok.hidden = true; cp.hidden = false; } }, 1600);
    }),
  );
</script>
