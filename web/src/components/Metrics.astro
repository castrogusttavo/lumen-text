---
import SectionHead from "./SectionHead.astro";
import { bench, fmt } from "../lib/bench";
import facts from "../data/facts.json";
const f = bench.facts;
const N = 24;
const filled = (v: number, max: number) => Math.max(1, Math.round((v / max) * N));
const frameMax = 20, ROWS = 14;
const colFill = (v: number, max: number) => Math.max(1, Math.round((v / max) * ROWS));
const lumen = (id: string) => bench.metrics.find((m) => m.id === id)?.values.lumen?.value ?? null;
const budgets = f.budgets.filter((b) => b.id !== "binary"); // install size is shown from the measured disk cell instead
const frames = [
  { label: "Scroll", value: lumen("scroll-frame") }, { label: "Keystroke", value: lumen("keystroke") }, { label: "60 Hz budget", value: 16.7 },
].filter((x): x is { label: string; value: number } => x.value !== null);
const stats = [
  { label: "Tests passing", value: facts.tests, dec: 0, unit: "" },
  { label: "Bundled themes", value: facts.themes, dec: 0, unit: "" },
  { label: "TextMate grammars", value: facts.grammars, dec: 0, unit: "" },
];
---
<section id="metrics" class="relative scroll-mt-24 py-28">
  <div class="pointer-events-none absolute inset-0 -z-10 dotgrid opacity-40 [mask-image:radial-gradient(60%_50%_at_50%_50%,#000,transparent)]"></div>
  <div class="container-x">
    <SectionHead eyebrow="Metrics">
      <Fragment slot="title">Metrics <span class="accent-word">active</span></Fragment>
      Budgets checked by the perf tests and CI, and the frame cost that only Lumen reports. Every figure comes from the repository data.
    </SectionHead>

    <div class="mt-14 overflow-hidden rounded-card border border-line">
      <div class="grid divide-y divide-line lg:grid-cols-2 lg:divide-x lg:divide-y-0" data-bars>
        <div class="p-7">
          <h3 class="text-xl font-medium tracking-tight">Against the budget</h3>
          <p class="mt-1 text-sm text-muted">Measured value versus the limit CI enforces</p>
          <ul class="mt-8 space-y-5">
            {budgets.map((b) => (
              <li>
                <div class="mb-1.5 flex justify-between font-mono text-[12px]"><span class="text-muted">{b.label}</span><span>{fmt(b.value)}<span class="text-faint"> / {b.limit} {b.unit}</span></span></div>
                <div class="seg" role="img" aria-label={`${b.value} of ${b.limit} ${b.unit}`}>{Array.from({ length: N }).map((_, i) => <i class:list={[i < filled(b.value, b.limit) && "t"]} style={`--i:${i}`}></i>)}</div>
              </li>
            ))}
          </ul>
        </div>
        <div class="p-7">
          <h3 class="text-xl font-medium tracking-tight">Frame cost</h3>
          <p class="mt-1 text-sm text-muted">Lumen only, not compared with other editors</p>
          <div class="mt-8 flex h-[260px] items-end justify-around gap-6">
            {frames.map((s, k) => (
              <div class="flex h-full flex-1 flex-col justify-end gap-2 text-center">
                <span class="font-mono text-xs">{s.value} ms</span>
                <div class="seg !h-auto flex-col-reverse !gap-[2px]" style="height:200px" role="img" aria-label={`${s.label}: ${s.value} ms`}>{Array.from({ length: ROWS }).map((_, i) => <i class:list={["!flex-none !h-[12px]", i < colFill(s.value, frameMax) && (k === 2 ? "t !opacity-40" : "t")]} style={`--i:${i}`}></i>)}</div>
                <span class="min-h-[2.4em] text-[10.5px] leading-tight text-faint">{s.label}</span>
              </div>
            ))}
          </div>
        </div>
      </div>
      <div class="grid divide-y divide-line border-t border-line sm:grid-cols-3 sm:divide-x sm:divide-y-0">
        {stats.map((s) => (
          <div class="px-6 py-9 text-center" data-reveal>
            <p class="text-sm text-muted">{s.label}</p>
            <p class="serif mt-3 text-5xl md:text-6xl"><span data-count={s.value} data-decimals={s.dec}>{s.value}</span>{s.unit}</p>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>
