---
import Logo from "./Logo.astro";
import { url, GITHUB } from "../lib/url";
const links = [
  ["Features", "/#features"], ["Compare", "/#compare"], ["Themes", "/#themes"], ["Docs", "/docs/getting-started"], ["Download", "/download"], ["Changelog", "/changelog"],
] as const;
---
<header class="sticky top-0 z-50 pt-3">
  <div class="container-x">
    <nav aria-label="Main" class="relative flex h-14 items-center justify-between rounded-full border border-line bg-[color-mix(in_srgb,var(--bg)_72%,transparent)] pl-5 pr-2 backdrop-blur-xl">
      <a href={url("/")} class="flex items-center gap-2.5 font-medium tracking-tight" aria-label="Lumen home">
        <span class="grid size-8 place-items-center rounded-[9px] bg-[#111] text-white ring-1 ring-white/10"><Logo size={22} /></span>
        <span class="text-[15px]">Lumen</span>
      </a>
      <ul class="hidden items-center gap-1 text-sm text-muted lg:flex">
        {links.map(([l, h]) => <li><a class="rounded-full px-3.5 py-2 transition-colors hover:text-fg" href={url(h)}>{l}</a></li>)}
      </ul>
      <div class="flex items-center gap-1.5">
        <button type="button" data-theme-toggle class="grid size-10 place-items-center rounded-full text-muted transition-colors hover:text-fg" aria-label="Toggle light and dark theme">
          <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><circle cx="12" cy="12" r="4.2"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
        </button>
        <a href={GITHUB} class="btn hidden h-10 lg:inline-flex" rel="noopener">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 .5A11.5 11.5 0 0 0 .5 12c0 5.08 3.29 9.38 7.86 10.9.58.1.79-.25.79-.56v-2c-3.2.7-3.87-1.37-3.87-1.37-.52-1.33-1.28-1.69-1.28-1.69-1.04-.71.08-.7.08-.7 1.15.08 1.76 1.18 1.76 1.18 1.03 1.76 2.7 1.25 3.35.96.1-.74.4-1.25.73-1.54-2.55-.29-5.24-1.28-5.24-5.69 0-1.26.45-2.28 1.18-3.09-.12-.29-.51-1.46.11-3.05 0 0 .97-.31 3.17 1.18a11 11 0 0 1 5.77 0c2.2-1.49 3.17-1.18 3.17-1.18.62 1.59.23 2.76.11 3.05.74.81 1.18 1.83 1.18 3.09 0 4.42-2.7 5.39-5.27 5.68.41.36.78 1.06.78 2.14v3.17c0 .31.21.67.8.56A11.5 11.5 0 0 0 23.5 12 11.5 11.5 0 0 0 12 .5Z"/></svg>
          GitHub
        </a>
        <a href={url("/download")} class="btn btn-primary h-10">Download</a>
        <details class="group relative lg:hidden">
          <summary class="grid size-10 cursor-pointer list-none place-items-center rounded-full text-muted [&::-webkit-details-marker]:hidden" aria-label="Menu">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><path d="M4 8h16M4 16h16"/></svg>
          </summary>
          <ul class="absolute right-0 top-12 w-56 rounded-2xl border border-line2 bg-solid p-2 shadow-2xl">
            {links.map(([l, h]) => <li><a class="block rounded-xl px-3 py-2.5 text-sm hover:bg-card" href={url(h)}>{l}</a></li>)}
            <li><a class="block rounded-xl px-3 py-2.5 text-sm hover:bg-card" href={GITHUB}>GitHub</a></li>
          </ul>
        </details>
      </div>
    </nav>
  </div>
</header>
