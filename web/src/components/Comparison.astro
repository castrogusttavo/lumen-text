---
import SectionHead from "./SectionHead.astro";
import { bench, fmt, hasValue, reasonOf, standings } from "../lib/bench";
type Metric = (typeof bench.metrics)[number];
const editors = bench.editors;
const lumen = editors[0]!;
const vs = editors.find((e) => e.id === "vscode")!;
const metric = (id: string) => bench.metrics.find((m) => m.id === id)!;
const val = (m: Metric, id: string) => { const c = m.values[id]; return hasValue(c) ? c.value : null; };
const show = (m: Metric, v: number) => `${fmt(Math.round(v * (v < 100 ? 10 : 1)) / (v < 100 ? 10 : 1))} ${m.unit}`;
const ratio = (a: number, b: number) => { const r = b / a; return r >= 10 ? String(Math.round(r)) : r.toFixed(1); };
const names = (xs: string[]) => xs.join(", ").replace(/, ([^,]*)$/, " and $1");

// A tab is one metric, one chart, one big stat. The stat is shown only when Lumen is strictly best and VS Code has a value.
const defs = [
  { id: "memory", tab: "Memory", metric: "ram-idle", caption: "Memory at rest", stat: "less RAM" },
  { id: "disk", tab: "Disk", metric: "disk", caption: "Install size", stat: "less disk" },
  { id: "startup", tab: "Startup", metric: "startup", caption: "Startup to first paint", stat: "faster startup" },
  { id: "typescript", tab: "TypeScript", metric: "lsp-first-diagnostics", caption: "Time to first TypeScript diagnostics", stat: "faster first diagnostics" },
];

const tabs = defs.map((d) => {
  const m = metric(d.metric);
  const rank = standings(m);
  const rows = rank.map((r) => ({ e: r.e, v: r.c.value, tip: r.c.note ?? "" }));
  const gone = editors.filter((e) => !hasValue(m.values[e.id])).map((e) => ({ e, tip: reasonOf(m.values[e.id]) }));
  const max = Math.max(...rows.map((r) => r.v));
  const a = val(m, lumen.id), b = val(m, vs.id);
  const best = rank[0]?.e.id === lumen.id && rank[1] && rank[0].c.value !== rank[1].c.value;
  const stat = best && a !== null && b !== null ? { n: ratio(a, b), text: `${d.stat} than ${vs.name}` } : null;
  return { ...d, m, rows, gone, max, stat };
});

// One honest line of context per tab, always derived from the cells.
const lowerThanLumen = (m: Metric) => standings(m).filter((r) => r.c.value < (val(m, lumen.id) ?? Infinity));
const ctx: Record<string, string> = {};
{
  const m = metric("ram-open-100k"); const a = val(m, lumen.id); const n = m.values[lumen.id]?.note?.match(/tsgo (\d+), lumen-text (\d+)/);
  const lo = lowerThanLumen(m);
  if (a !== null) ctx.memory = `With a 100k-line TypeScript file Lumen uses ${show(m, a)}${n ? ` (${n[2]} editor + ${n[1]} tsgo)` : ""}${lo.length ? `; ${names(lo.map((r) => r.e.name))} ${lo.length > 1 ? "use" : "uses"} ${lo.map((r) => show(m, r.c.value)).join(" and ")}` : ""}.`;
}
{
  const c = metric("disk").values[lumen.id]?.note ?? ""; const bin = c.match(/binary alone ([\d.]+) MB/)?.[1]; const ts = c.match(/tsgo download adds (\d+) MB/)?.[1];
  if (bin && ts) ctx.disk = `Lumen's binary alone is ${bin} MB; the optional TypeScript server (tsgo) adds ${ts} MB.`;
}
{
  const m = metric("open-100k"); const a = val(m, lumen.id); const lo = lowerThanLumen(m);
  if (a !== null) ctx.startup = `Straight into a 100k-line file Lumen takes ${show(m, a)}${lo.length ? `; ${names(lo.map((r) => r.e.name))} ${lo.length > 1 ? "are" : "is"} faster at ${lo.map((r) => show(m, r.c.value)).join(" and ")}` : ""}.`;
}
{
  const m = metric("lsp-memory"); const rows = standings(m);
  const miss = editors.filter((e) => !hasValue(m.values[e.id])).map((e) => e.name);
  if (rows.length) ctx.typescript = `TypeScript server memory: ${rows.map((r) => `${r.e.name} ${show(m, r.c.value)}`).join(", ")}${miss.length ? `. ${names(miss)} ${miss.length > 1 ? "have" : "has"} no built-in server to measure` : ""}.`;
}

const runs = bench.metrics.flatMap((m) => Object.values(m.values)).map((c) => c.note?.match(/N=(\d+)/)?.[1]).find(Boolean);
const extra = bench.metrics.filter((m) => m.required !== false && !defs.some((d) => d.metric === m.id));
const soloMetrics = bench.metrics.filter((m) => m.required === false);
const gaps = (() => {
  const seen = new Map<string, { e: (typeof editors)[number]; r: string }>();
  for (const m of bench.metrics.filter((x) => x.required !== false)) for (const e of editors) if (!hasValue(m.values[e.id])) seen.set(e.id + reasonOf(m.values[e.id]), { e, r: reasonOf(m.values[e.id]) });
  return [...seen.values()];
})();
const tip = (s: string) => s.replace(/\s+/g, " ");
---
<section id="compare" class="container-x scroll-mt-24 py-28" data-compare>
  <SectionHead eyebrow="Compare">
    <Fragment slot="title">Small enough you <span class="accent-word">notice</span></Fragment>
    Lumen against the editors you already use, measured on one machine, one at a time.
  </SectionHead>

  <div class="mx-auto mt-12 max-w-3xl">
    <div class="cmp-tabs" role="tablist" aria-label="Metric">
      {tabs.map((t, i) => <button type="button" role="tab" id={`cmp-tab-${t.id}`} aria-controls={`cmp-${t.id}`} aria-selected={i === 0 ? "true" : "false"} tabindex={i === 0 ? 0 : -1} data-tab={t.id}>{t.tab}</button>)}
    </div>

    <div class="cmp-panel plus mt-5 rounded-card border border-line bg-card" data-reveal>
      <div class="plus-b"></div>
      {tabs.map((t, i) => (
        <div id={`cmp-${t.id}`} role="tabpanel" aria-labelledby={`cmp-tab-${t.id}`} class:list={[i === 0 && "on"]} data-panel={t.id} data-bars>
          <div class="px-6 pb-2 pt-9 sm:px-9">
            {t.stat ? (
              <p class="serif text-balance text-[clamp(2.2rem,8vw,4.5rem)] leading-none"><span class="text-accent">{t.stat.n}x</span> <span class="text-fg">{t.stat.text}</span></p>
            ) : (
              <p class="serif text-[clamp(2rem,7vw,3.2rem)] leading-none">{t.caption}</p>
            )}
            <p class="mt-3 font-mono text-[12px] text-faint">{t.caption} · {t.m.unit} · lower is better</p>
          </div>
          <ul class="space-y-1 px-3 pb-5 pt-4 sm:px-6">
            {t.rows.map((r, k) => (
              <li class="cmp-row" tabindex="0" aria-describedby={`tip-${t.id}-${r.e.id}`}>
                <span class:list={["truncate text-[13px]", r.e.highlight ? "font-medium text-fg" : "text-muted"]}>{r.e.name}</span>
                <div class="cmp-track" role="img" aria-label={`${r.e.name}: ${show(t.m, r.v)}`}><div class:list={["cmp-fill", r.e.highlight && "is-lumen"]} style={`--w:${Math.max(1.5, (r.v / t.max) * 100)}%;--d:${k * 50}ms`}></div></div>
                <span class:list={["text-right font-mono text-[12.5px]", r.e.highlight ? "text-accent" : "text-fg"]}>{show(t.m, r.v)}</span>
                <span role="tooltip" id={`tip-${t.id}-${r.e.id}`} class="cmp-tip">{tip(r.tip)}</span>
              </li>
            ))}
            {t.gone.map((g) => (
              <li class="cmp-row" tabindex="0" aria-describedby={`tip-${t.id}-${g.e.id}`}>
                <span class="truncate text-[13px] text-faint">{g.e.name}</span>
                <div class="cmp-track cmp-na" aria-hidden="true"></div>
                <span class="text-right font-mono text-[12.5px] text-faint">n/a</span>
                <span role="tooltip" id={`tip-${t.id}-${g.e.id}`} class="cmp-tip">{tip(g.tip)}</span>
              </li>
            ))}
          </ul>
          {ctx[t.id] && <p class="border-t border-line px-6 py-4 text-[13px] leading-relaxed text-muted sm:px-9">{ctx[t.id]}</p>}
        </div>
      ))}
    </div>

    <details class="mt-4 rounded-card border border-line px-6 py-4 text-[13px] leading-relaxed text-muted sm:px-9" data-reveal>
      <summary class="cursor-pointer select-none font-mono text-xs text-fg">How we measured</summary>
      <div class="mt-4 space-y-5">
        <p>{bench.methodology}</p>
        <dl class="grid grid-cols-[auto_1fr] gap-x-5 gap-y-1.5 font-mono text-xs">
          <dt class="text-faint">Machine</dt><dd>{bench.machine.label}</dd>
          {bench.machine.note && <><dt class="text-faint">Note</dt><dd>{bench.machine.note}</dd></>}
          <dt class="text-faint">Measured</dt><dd>{bench.measuredAt ?? "pending"}{runs ? `, median of ${runs} runs` : ""}</dd>
          <dt class="text-faint">Versions</dt><dd>{editors.map((e) => `${e.name} ${e.version}`).join(" · ")}</dd>
        </dl>
        {(extra.length > 0) && (
          <div>
            <p class="mb-2 font-mono text-xs text-fg">Also measured</p>
            <ul class="space-y-1.5">
              {extra.map((m) => <li><span class="text-fg">{m.label}</span>: {standings(m).map((r) => `${r.e.name} ${show(m, r.c.value)}`).join(", ")}</li>)}
            </ul>
          </div>
        )}
        {gaps.length > 0 && (
          <div>
            <p class="mb-2 font-mono text-xs text-fg">Why some cells say n/a</p>
            <ul class="space-y-1.5">
              {gaps.map((g) => <li><span class="text-fg">{g.e.name}</span>: {g.r}</li>)}
            </ul>
          </div>
        )}
        {soloMetrics.length > 0 && <p>Frame and keystroke cost are measured for Lumen only (see Metrics below) because the other editors expose no comparable counter.</p>}
        <p>Windsurf and Devin are VS Code forks and are expected to land in the same range as {vs.name}.</p>
      </div>
    </details>
  </div>
</section>

<script>
  document.querySelectorAll<HTMLElement>("[data-compare]").forEach((root) => {
    const tabs = [...root.querySelectorAll<HTMLButtonElement>("[role=tab]")];
    const panels = [...root.querySelectorAll<HTMLElement>("[role=tabpanel]")];
    const select = (t: HTMLButtonElement, focus = false) => {
      tabs.forEach((b) => { const on = b === t; b.setAttribute("aria-selected", String(on)); b.tabIndex = on ? 0 : -1; });
      panels.forEach((p) => {
        const on = p.id === t.getAttribute("aria-controls");
        p.classList.toggle("on", on);
        if (on) { p.classList.remove("in"); void p.offsetWidth; p.classList.add("in"); }
      });
      if (focus) t.focus();
    };
    tabs.forEach((t, i) => {
      t.addEventListener("click", () => select(t));
      t.addEventListener("keydown", (e) => {
        const k = e.key;
        const n = k === "ArrowRight" ? (i + 1) % tabs.length : k === "ArrowLeft" ? (i - 1 + tabs.length) % tabs.length : k === "Home" ? 0 : k === "End" ? tabs.length - 1 : -1;
        if (n >= 0) { e.preventDefault(); select(tabs[n]!, true); }
      });
    });
  });
</script>
