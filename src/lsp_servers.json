{
  "_comment": "Built-in language servers. A server only starts when its command is found (PATH, <project>/node_modules/.bin, ~/.local/share/lumen-text/lsp/bin, ~/.cargo/bin, ~/.local/bin, ~/go/bin). Order matters: for a language the first installed 'primary' wins, 'companion' servers run next to it. harper-ls and typos-lsp (spell checking) stay off until spell_check is true. '${root}' in args, env and options is the server's workspace root.",
  "servers": [
    {"id": "rust-analyzer", "command": "rust-analyzer", "languages": ["rust"], "root_markers": ["Cargo.toml", "rust-project.json"], "install": "rustup component add rust-analyzer"},
    {"id": "pyright", "command": "pyright-langserver", "args": ["--stdio"], "languages": ["python"], "root_markers": ["pyrightconfig.json", "pyproject.toml", "setup.py", "setup.cfg", "requirements.txt", ".git"], "install": "npm i -g pyright"},
    {"id": "basedpyright", "command": "basedpyright-langserver", "args": ["--stdio"], "languages": ["python"], "root_markers": ["pyrightconfig.json", "pyproject.toml", "setup.py", "setup.cfg", "requirements.txt", ".git"], "install": "pip install basedpyright"},
    {"id": "pylsp", "command": "pylsp", "languages": ["python"], "root_markers": ["pyproject.toml", "setup.py", "setup.cfg", "requirements.txt", ".git"], "install": "pip install python-lsp-server"},
    {"id": "ruff", "role": "companion", "command": "ruff", "args": ["server"], "languages": ["python"], "root_markers": ["ruff.toml", ".ruff.toml", "pyproject.toml", ".git"], "install": "pip install ruff"},
    {"id": "gopls", "command": "gopls", "languages": ["go"], "root_markers": ["go.work", "go.mod", ".git"], "install": "go install golang.org/x/tools/gopls@latest"},
    {"id": "clangd", "command": "clangd", "args": ["--pch-storage=disk"], "languages": ["c", "cpp"], "extensions": ["h", "hh", "hpp", "hxx", "cc", "cxx", "c++", "ipp"], "root_markers": ["compile_commands.json", "compile_flags.txt", ".clangd", ".git"], "install": "install clangd with your package manager"},
    {"id": "jdtls", "command": "jdtls", "languages": ["java"], "root_markers": ["pom.xml", "build.gradle", "build.gradle.kts", "settings.gradle", "settings.gradle.kts", ".project", ".git"], "install": "download Eclipse JDT LS (https://github.com/eclipse-jdtls/eclipse.jdt.ls) and put bin/jdtls on PATH; current releases need Java 25+"},
    {"id": "csharp-ls", "command": "csharp-ls", "languages": ["csharp"], "root_markers": ["*.sln", "*.slnx", "*.csproj", ".git"], "install": "dotnet tool install --global csharp-ls"},
    {"id": "omnisharp", "command": "OmniSharp", "args": ["-lsp"], "languages": ["csharp"], "root_markers": ["*.sln", "*.csproj", ".git"], "install": "download OmniSharp (https://github.com/OmniSharp/omnisharp-roslyn/releases)"},
    {"id": "kotlin-lsp", "command": "kotlin-lsp", "args": ["--stdio"], "languages": ["kotlin"], "root_markers": ["settings.gradle.kts", "settings.gradle", "build.gradle.kts", "build.gradle", "pom.xml", ".git"], "install": "JetBrains Kotlin LSP: download the standalone archive from https://github.com/Kotlin/kotlin-lsp/releases, put kotlin-lsp.sh on PATH as kotlin-lsp, accept its EULA once (kotlin-lsp --show-eula)"},
    {"id": "kotlin-language-server", "command": "kotlin-language-server", "languages": ["kotlin"], "root_markers": ["settings.gradle.kts", "settings.gradle", "build.gradle.kts", "build.gradle", "pom.xml", ".git"], "install": "deprecated fwcd server (fails on Java 25+): https://github.com/fwcd/kotlin-language-server/releases; prefer kotlin-lsp"},
    {"id": "dockerfile-language-server", "command": "docker-langserver", "args": ["--stdio"], "languages": ["docker"], "root_markers": [".git"], "install": "npm i -g dockerfile-language-server-nodejs"},
    {"id": "sourcekit-lsp", "command": "sourcekit-lsp", "languages": ["swift", "objective-c", "objective-cpp"], "root_markers": ["Package.swift", "*.xcodeproj", ".git"], "install": "comes with the Swift toolchain (https://swift.org/install)"},
    {"id": "dart", "command": "dart", "args": ["language-server", "--protocol=lsp"], "languages": ["dart"], "root_markers": ["pubspec.yaml", ".git"], "install": "comes with the Dart/Flutter SDK"},
    {"id": "elixir-ls", "command": "elixir-ls", "languages": ["elixir"], "root_markers": ["mix.exs", ".git"], "install": "install elixir-ls with your package manager"},
    {"id": "haskell-language-server", "command": "haskell-language-server-wrapper", "args": ["--lsp"], "languages": ["haskell"], "root_markers": ["stack.yaml", "cabal.project", "*.cabal", "hie.yaml", ".git"], "install": "ghcup install hls"},
    {"id": "metals", "command": "metals", "languages": ["scala"], "root_markers": ["build.sbt", "build.sc", "build.mill", ".git"], "install": "cs install metals"},
    {"id": "terraform-ls", "command": "terraform-ls", "args": ["serve"], "languages": ["terraform"], "root_markers": [".terraform", ".git"], "install": "install terraform-ls (https://github.com/hashicorp/terraform-ls)"},
    {"id": "lua-language-server", "command": "lua-language-server", "languages": ["lua"], "root_markers": [".luarc.json", ".luarc.jsonc", ".stylua.toml", ".git"], "install": "install lua-language-server with your package manager"},
    {"id": "taplo", "command": "taplo", "args": ["lsp", "stdio"], "languages": ["toml"], "root_markers": ["taplo.toml", ".taplo.toml", ".git"], "install": "cargo install taplo-cli --locked --features lsp", "settings": {"evenBetterToml": {"schema": {"enabled": true, "catalogs": [], "associations": {".*/Cargo\\.toml$": "https://json.schemastore.org/cargo.json", ".*/pyproject\\.toml$": "https://json.schemastore.org/pyproject.json", ".*/(\\.)?rustfmt\\.toml$": "https://json.schemastore.org/rustfmt.json", ".*/(\\.)?clippy\\.toml$": "https://json.schemastore.org/clippy.json", ".*/rust-toolchain\\.toml$": "https://json.schemastore.org/rust-toolchain.json", ".*/(\\.)?ruff\\.toml$": "https://json.schemastore.org/ruff.json", ".*/netlify\\.toml$": "https://json.schemastore.org/netlify.json", ".*/wrangler\\.toml$": "https://json.schemastore.org/wrangler.json", ".*/fly\\.toml$": "https://json.schemastore.org/fly.json", ".*/(\\.)?taplo\\.toml$": "https://json.schemastore.org/taplo.json", ".*/\\.cargo/config(\\.toml)?$": "https://json.schemastore.org/cargo.json", ".*/deny\\.toml$": "https://json.schemastore.org/cargo-deny.json", ".*/Pipfile$": "https://json.schemastore.org/pipfile.json"}}, "formatter": {}}}},
    {"id": "vscode-json-language-server", "command": "vscode-json-language-server", "args": ["--stdio"], "languages": ["json"], "extensions": ["jsonc"], "root_markers": ["package.json", ".git"], "install": "npm i -g vscode-langservers-extracted", "settings": {"json": {"validate": {"enable": true}, "format": {"enable": true}, "schemas": [{"fileMatch": ["package.json"], "url": "https://json.schemastore.org/package.json"}, {"fileMatch": ["tsconfig.json", "tsconfig.*.json", "tsconfig-*.json"], "url": "https://json.schemastore.org/tsconfig.json"}, {"fileMatch": ["jsconfig.json", "jsconfig.*.json"], "url": "https://json.schemastore.org/jsconfig.json"}, {"fileMatch": [".eslintrc", ".eslintrc.json"], "url": "https://json.schemastore.org/eslintrc.json"}, {"fileMatch": [".prettierrc", ".prettierrc.json"], "url": "https://json.schemastore.org/prettierrc.json"}, {"fileMatch": [".babelrc", ".babelrc.json", "babel.config.json"], "url": "https://json.schemastore.org/babelrc.json"}, {"fileMatch": ["composer.json"], "url": "https://json.schemastore.org/composer.json"}, {"fileMatch": ["deno.json", "deno.jsonc"], "url": "https://json.schemastore.org/deno.json"}, {"fileMatch": ["turbo.json"], "url": "https://json.schemastore.org/turbo.json"}, {"fileMatch": ["vercel.json"], "url": "https://json.schemastore.org/vercel.json"}, {"fileMatch": ["biome.json", "biome.jsonc"], "url": "https://json.schemastore.org/biome.json"}, {"fileMatch": ["lerna.json"], "url": "https://json.schemastore.org/lerna.json"}, {"fileMatch": ["nest-cli.json"], "url": "https://json.schemastore.org/nest-cli.json"}, {"fileMatch": ["renovate.json", ".renovaterc", ".renovaterc.json"], "url": "https://json.schemastore.org/renovate.json"}, {"fileMatch": ["appsettings.json", "appsettings.*.json"], "url": "https://json.schemastore.org/appsettings.json"}, {"fileMatch": ["launchSettings.json"], "url": "https://json.schemastore.org/launchsettings.json"}, {"fileMatch": [".swcrc"], "url": "https://json.schemastore.org/swcrc.json"}, {"fileMatch": ["manifest.json", "*.webmanifest"], "url": "https://json.schemastore.org/web-manifest-combined.json"}, {"fileMatch": [".devcontainer.json", "devcontainer.json"], "url": "https://json.schemastore.org/devcontainer.json"}]}}},
    {"id": "vscode-css-language-server", "command": "vscode-css-language-server", "args": ["--stdio"], "languages": ["css", "scss"], "extensions": ["less"], "root_markers": ["package.json", ".git"], "install": "npm i -g vscode-langservers-extracted", "settings": {"css": {"validate": true, "lint": {"unknownAtRules": "ignore"}}, "scss": {"validate": true, "lint": {"unknownAtRules": "ignore"}}, "less": {"validate": true, "lint": {"unknownAtRules": "ignore"}}}},
    {"id": "vscode-html-language-server", "command": "vscode-html-language-server", "args": ["--stdio"], "languages": ["html"], "root_markers": ["package.json", ".git"], "initialization_options": {"provideFormatter": true}, "install": "npm i -g vscode-langservers-extracted"},
    {"id": "yaml-language-server", "command": "yaml-language-server", "args": ["--stdio"], "languages": ["yaml"], "root_markers": [".git"], "install": "npm i -g yaml-language-server", "settings": {"yaml": {"validate": true, "hover": true, "completion": true, "format": {"enable": true}, "schemaStore": {"enable": true, "url": "https://www.schemastore.org/api/json/catalog.json"}, "keyOrdering": false}}},
    {"id": "bash-language-server", "command": "bash-language-server", "args": ["start"], "languages": ["shellscript"], "root_markers": [".git"], "install": "npm i -g bash-language-server"},
    {"id": "marksman", "command": "marksman", "args": ["server"], "languages": ["markdown"], "root_markers": [".marksman.toml", ".git"], "install": "install marksman with your package manager"},
    {"id": "zls", "command": "zls", "languages": ["zig"], "root_markers": ["build.zig", "zls.json", ".git"], "install": "install zls with your package manager"},
    {"id": "ruby-lsp", "command": "ruby-lsp", "languages": ["ruby"], "root_markers": ["Gemfile", ".ruby-version", ".git"], "install": "gem install ruby-lsp"},
    {"id": "solargraph", "command": "solargraph", "args": ["stdio"], "languages": ["ruby"], "root_markers": ["Gemfile", ".solargraph.yml", ".git"], "install": "gem install solargraph"},
    {"id": "phpactor", "command": "phpactor", "args": ["language-server"], "languages": ["php"], "root_markers": ["composer.json", ".phpactor.json", ".git"], "install": "install phpactor (https://phpactor.readthedocs.io)"},
    {"id": "intelephense", "command": "intelephense", "args": ["--stdio"], "languages": ["php"], "root_markers": ["composer.json", ".git"], "install": "npm i -g intelephense"},
    {"id": "svelte", "command": "svelteserver", "args": ["--stdio"], "languages": ["svelte"], "root_markers": ["svelte.config.js", "svelte.config.ts", "package.json", ".git"], "install": "npm i -g svelte-language-server"},
    {"id": "astro", "command": "astro-ls", "args": ["--stdio"], "languages": ["astro"], "root_markers": ["astro.config.mjs", "astro.config.ts", "astro.config.js", "package.json", ".git"], "initialization_options": {"typescript": {"tsdk": "${root}/node_modules/typescript/lib"}}, "install": "npm i -g @astrojs/language-server"},
    {"id": "vue", "command": "vue-language-server", "args": ["--stdio"], "languages": ["vue"], "root_markers": ["vue.config.js", "vite.config.ts", "vite.config.js", "nuxt.config.ts", "package.json", ".git"], "initialization_options": {"typescript": {"tsdk": "${root}/node_modules/typescript/lib"}}, "install": "npm i -g @vue/language-server"},
    {"id": "ghp-lsp", "command": "ghp-lsp", "languages": ["ghp"], "root_markers": ["go.mod", "go.work", ".git"], "install": "download the archive for your OS from https://github.com/GHP-GoLang-Framework/ghp-lsp/releases and put ghp-lsp on PATH or in ~/.local/share/lumen-text/lsp/bin (gopls is optional: go install golang.org/x/tools/gopls@latest, for the Go expressions)"},
    {"id": "tailwindcss", "role": "companion", "command": "tailwindcss-language-server", "args": ["--stdio"], "languages": ["typescript", "tsx", "javascript", "jsx", "css", "scss", "html", "svelte", "vue", "astro"], "root_markers": ["tailwind.config.js", "tailwind.config.ts", "tailwind.config.cjs", "tailwind.config.mjs", "postcss.config.js", "package.json"], "requires": ["tailwind.config.js", "tailwind.config.ts", "tailwind.config.cjs", "tailwind.config.mjs", "node_modules/tailwindcss"], "settings": {"tailwindCSS": {"validate": true, "lint": {}, "includeLanguages": {}}}, "install": "npm i -g @tailwindcss/language-server"},
    {"id": "deno", "command": "deno", "args": ["lsp"], "languages": ["typescript", "tsx", "javascript", "jsx"], "root_markers": ["deno.json", "deno.jsonc"], "requires": ["deno.json", "deno.jsonc"], "initialization_options": {"enable": true, "lint": true}, "install": "install deno (https://deno.com)"},
    {"id": "harper-ls", "role": "companion", "enabled": false, "command": "harper-ls", "args": ["--stdio"], "languages": ["rust", "typescript", "tsx", "javascript", "jsx", "python", "go", "c", "cpp", "csharp", "java", "kotlin", "swift", "dart", "scala", "haskell", "elixir", "lua", "ruby", "php", "shellscript", "zig", "nix", "toml", "html", "markdown", "latex", "typst", "git-commit"], "extensions": ["txt", "text"], "root_markers": [".git"], "settings": {"harper-ls": {"diagnosticSeverity": "information"}}, "install": "cargo install harper-ls --locked (or a binary from https://github.com/Automattic/harper/releases)"},
    {"id": "typos-lsp", "role": "companion", "enabled": false, "command": "typos-lsp", "languages": ["rust", "typescript", "tsx", "javascript", "jsx", "python", "go", "c", "cpp", "csharp", "java", "kotlin", "swift", "dart", "scala", "haskell", "elixir", "lua", "ruby", "php", "shellscript", "zig", "nix", "toml", "html", "markdown", "latex", "typst", "git-commit", "css", "scss", "less", "yaml", "sql", "vue", "svelte", "astro"], "extensions": ["txt", "text"], "root_markers": ["typos.toml", "_typos.toml", ".typos.toml", ".git"], "initialization_options": {"diagnosticSeverity": "Info"}, "install": "a binary from https://github.com/tekumara/typos-lsp/releases (or cargo install --git https://github.com/tekumara/typos-lsp typos-lsp)"},
    {"id": "copilot", "role": "companion", "enabled": false, "command": "copilot-language-server", "args": ["--stdio"], "languages": ["*"], "root_markers": [".git"], "initialization_options": {"editorInfo": {"name": "Lumen", "version": "1.0.0"}, "editorPluginInfo": {"name": "lumen-inline-completion", "version": "1.0.0"}}, "install": "npm i -g @github/copilot-language-server, then the palette command Copilot: Sign in (inline completions, setting inline_completion)"}
  ]
}
