# Maintainer: castrogusttavo
# AUR-style source package: builds the tagged source tree with cargo.
# Versions are CalVer (YYYY.M.D.N); release tags are v$pkgver. Bump pkgver, then `updpkgsums`.
pkgname=lumen-text
pkgver=2026.11.9.1
pkgrel=1
pkgdesc='Lightweight code editor in Rust with TextMate highlighting and a TypeScript workflow'
arch=('x86_64' 'aarch64')
url='https://github.com/castrogusttavo/lumen-text'
license=('MIT')
# Only libc/libgcc are linked; the windowing libraries are dlopen()ed at run time.
depends=('gcc-libs' 'glibc' 'libxkbcommon' 'fontconfig')
makedepends=('cargo' 'clang' 'pkgconf')
optdepends=('wayland: Wayland sessions'
            'libxkbcommon-x11: X11 sessions'
            'libx11: X11 sessions'
            'libxcursor: X11 sessions'
            'libxi: X11 sessions'
            'wl-clipboard: clipboard support on Wayland'
            'xclip: clipboard support on X11'
            'npm: install the TypeScript language server (tsgo)')
options=('!lto')
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('SKIP')  # run updpkgsums once the tag is published

prepare() {
  cd "$pkgname-$pkgver"
  export RUSTUP_TOOLCHAIN=stable
  cargo fetch --locked --target "$(rustc -vV | sed -n 's/host: //p')"
}

build() {
  cd "$pkgname-$pkgver"
  export RUSTUP_TOOLCHAIN=stable
  export CARGO_TARGET_DIR=target
  export LUMEN_VERSION="$pkgver"   # stamps the About/--version string (Cargo.toml is not bumped)
  cargo build --release --locked
}

package() {
  cd "$pkgname-$pkgver"
  install -Dm755 "target/release/$pkgname" "$pkgdir/usr/bin/$pkgname"
  # config::assets_dir() looks at <exe dir>/../share/lumen-text/assets,
  # i.e. /usr/share/lumen-text/assets for /usr/bin/lumen-text.
  install -dm755 "$pkgdir/usr/share/$pkgname"
  cp -r assets "$pkgdir/usr/share/$pkgname/assets"
  install -Dm644 "$pkgname.desktop" "$pkgdir/usr/share/applications/$pkgname.desktop"
  install -Dm644 packaging/icons/$pkgname.svg "$pkgdir/usr/share/icons/hicolor/scalable/apps/$pkgname.svg"
  for n in 16 24 32 48 64 128 256 512; do
    install -Dm644 packaging/icons/png/$pkgname-$n.png "$pkgdir/usr/share/icons/hicolor/${n}x${n}/apps/$pkgname.png"
  done
  install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
